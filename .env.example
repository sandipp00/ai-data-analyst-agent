GOOGLE_API_KEY=your-key-here
LLM_MODEL=gemini-3.8-flash
# Tried in order if the main model fails (each has its own free-tier daily quota)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
LLM_TIMEOUT_S=60

# Used by the agent: read-only role created by scripts/seed.py
DATABASE_URL=postgresql://analyst_ro:analyst_ro@localhost:5433/analytics
# Used only for seeding (owner role)
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/analytics

MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=15000
MAX_SQL_RETRIES=2

# Free Gemini tier allows ~5 requests/min; raise on a paid plan
LLM_REQUESTS_PER_MINUTE=4
